{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "types": ["node", "express"]
  },
  "include": ["src/api/**/*", "src/types/**/*", "src/lib/**/*"],
  "exclude": ["node_modules", "dist"]
}